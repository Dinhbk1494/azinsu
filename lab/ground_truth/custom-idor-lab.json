{
  "target": "custom-idor-lab",
  "base_url": "http://localhost:8080",
  "users": [
    {"email": "userA@test.com", "password": "userA123!", "user_id": 1, "label": "userA"},
    {"email": "userB@test.com", "password": "userB123!", "user_id": 2, "label": "userB"},
    {"email": "admin@test.com", "password": "admin123!", "user_id": 3, "label": "admin"}
  ],
  "idors": [
    {
      "id": "CUSTOM-IDOR-01",
      "idor_number": 1,
      "type": "numeric_id_in_path",
      "endpoint": "/api/users/{user_id}/profile",
      "method": "GET",
      "description": "User profile IDOR via numeric ID in URL path",
      "vulnerable_param": "user_id",
      "param_location": "path",
      "test_with_id": 2,
      "evidence_field": "email",
      "difficulty": "easy"
    },
    {
      "id": "CUSTOM-IDOR-02",
      "idor_number": 2,
      "type": "numeric_id_in_query",
      "endpoint": "/api/orders",
      "method": "GET",
      "description": "Order access via order_id query parameter",
      "vulnerable_param": "order_id",
      "param_location": "query",
      "test_with_id": 3,
      "evidence_field": "user_id",
      "difficulty": "easy"
    },
    {
      "id": "CUSTOM-IDOR-03",
      "idor_number": 3,
      "type": "id_in_request_body",
      "endpoint": "/api/messages/read",
      "method": "POST",
      "description": "Mark any message as read via message_id in body",
      "vulnerable_param": "message_id",
      "param_location": "body",
      "test_with_id": 2,
      "evidence_field": "content",
      "difficulty": "easy"
    },
    {
      "id": "CUSTOM-IDOR-04",
      "idor_number": 4,
      "type": "id_in_custom_header",
      "endpoint": "/api/account/balance",
      "method": "GET",
      "description": "Account balance via X-Account-Id header",
      "vulnerable_param": "X-Account-Id",
      "param_location": "header",
      "test_with_id": 2,
      "evidence_field": "email",
      "difficulty": "easy"
    },
    {
      "id": "CUSTOM-IDOR-05",
      "idor_number": 5,
      "type": "sequential_enumeration",
      "endpoint": "/api/invoices/{invoice_id}",
      "method": "GET",
      "description": "Invoice IDOR via sequential numeric ID",
      "vulnerable_param": "invoice_id",
      "param_location": "path",
      "test_with_id": 3,
      "evidence_field": "user_id",
      "difficulty": "easy"
    },
    {
      "id": "CUSTOM-IDOR-06",
      "idor_number": 6,
      "type": "id_in_cookie",
      "endpoint": "/api/dashboard",
      "method": "GET",
      "description": "Dashboard data via current_user_id cookie",
      "vulnerable_param": "current_user_id",
      "param_location": "cookie",
      "test_with_id": 2,
      "evidence_field": "email",
      "difficulty": "easy"
    },
    {
      "id": "CUSTOM-IDOR-07",
      "idor_number": 7,
      "type": "predictable_filename",
      "endpoint": "/uploads/user_{user_id}_data.json",
      "method": "GET",
      "description": "Direct file access via predictable filename, no auth",
      "vulnerable_param": "user_id",
      "param_location": "path",
      "test_with_id": 2,
      "evidence_field": "email",
      "difficulty": "easy"
    },
    {
      "id": "CUSTOM-IDOR-08",
      "idor_number": 8,
      "type": "uuid_enumeration_via_leak",
      "endpoint": "/api/docs/{uuid}",
      "method": "GET",
      "description": "Document IDOR via UUID leaked from /api/docs/recent",
      "vulnerable_param": "uuid",
      "param_location": "path",
      "leak_endpoint": "/api/docs/recent",
      "evidence_field": "user_id",
      "difficulty": "medium"
    },
    {
      "id": "CUSTOM-IDOR-09",
      "idor_number": 9,
      "type": "base64_encoded_id",
      "endpoint": "/api/items",
      "method": "GET",
      "description": "Item IDOR via base64-encoded ID in ?ref= parameter",
      "vulnerable_param": "ref",
      "param_location": "query",
      "test_with_encoded": "Mw==",
      "evidence_field": "user_id",
      "difficulty": "medium"
    },
    {
      "id": "CUSTOM-IDOR-10",
      "idor_number": 10,
      "type": "hex_encoded_id",
      "endpoint": "/api/resources/{hex_id}",
      "method": "GET",
      "description": "Resource IDOR via hex-encoded user ID",
      "vulnerable_param": "hex_id",
      "param_location": "path",
      "test_with_id": "0x2",
      "evidence_field": "email",
      "difficulty": "medium"
    },
    {
      "id": "CUSTOM-IDOR-11",
      "idor_number": 11,
      "type": "nested_resource_idor",
      "endpoint": "/api/orgs/{org_id}/users/{user_id}/messages",
      "method": "GET",
      "description": "Message IDOR via nested resource (user_id not checked)",
      "vulnerable_param": "user_id",
      "param_location": "path",
      "test_with_id": 2,
      "evidence_field": "content",
      "difficulty": "medium"
    },
    {
      "id": "CUSTOM-IDOR-12",
      "idor_number": 12,
      "type": "http_method_bypass",
      "endpoint": "/api/admin/users/{user_id}",
      "method": "POST",
      "description": "Admin endpoint bypassed via POST method (GET is protected)",
      "vulnerable_param": "user_id",
      "param_location": "path",
      "test_with_id": 2,
      "evidence_field": "email",
      "difficulty": "medium"
    },
    {
      "id": "CUSTOM-IDOR-13",
      "idor_number": 13,
      "type": "mass_assignment",
      "endpoint": "/api/users/update",
      "method": "POST",
      "description": "Mass assignment IDOR via user_id in body",
      "vulnerable_param": "user_id",
      "param_location": "body",
      "test_with_id": 2,
      "evidence_field": "name",
      "difficulty": "medium"
    },
    {
      "id": "CUSTOM-IDOR-14",
      "idor_number": 14,
      "type": "graphql_idor",
      "endpoint": "/graphql",
      "method": "POST",
      "description": "GraphQL user query without authorization",
      "vulnerable_param": "id",
      "param_location": "body",
      "test_with_id": 2,
      "evidence_field": "email",
      "difficulty": "medium"
    },
    {
      "id": "CUSTOM-IDOR-15",
      "idor_number": 15,
      "type": "predictable_slug",
      "endpoint": "/api/share/{slug}",
      "method": "GET",
      "description": "Shared resource via predictable user_{id}_doc_{seq} slug",
      "vulnerable_param": "slug",
      "param_location": "path",
      "test_slug": "user_2_doc_1",
      "evidence_field": "user_id",
      "difficulty": "hard"
    },
    {
      "id": "CUSTOM-IDOR-16",
      "idor_number": 16,
      "type": "read_protected_write_not",
      "endpoint": "/api/posts/{post_id}",
      "method": "DELETE",
      "description": "Delete any post — auth on GET but not DELETE",
      "vulnerable_param": "post_id",
      "param_location": "path",
      "test_with_id": 3,
      "evidence_field": "deleted_id",
      "difficulty": "hard"
    },
    {
      "id": "CUSTOM-IDOR-17",
      "idor_number": 17,
      "type": "jwt_claim_not_validated",
      "endpoint": "/api/profile/jwt",
      "method": "GET",
      "description": "JWT user_id claim accepted without session cross-check",
      "vulnerable_param": "user_id",
      "param_location": "header",
      "evidence_field": "email",
      "difficulty": "hard"
    },
    {
      "id": "CUSTOM-IDOR-18",
      "idor_number": 18,
      "type": "role_escalation_via_mass_assignment",
      "endpoint": "/api/users/{user_id}/role",
      "method": "PUT",
      "description": "Any user can change any user's role",
      "vulnerable_param": "user_id",
      "param_location": "path",
      "test_with_id": 1,
      "evidence_field": "role",
      "difficulty": "hard"
    },
    {
      "id": "CUSTOM-IDOR-19",
      "idor_number": 19,
      "type": "missing_ownership_on_cancel",
      "endpoint": "/api/orders/{order_id}/cancel",
      "method": "POST",
      "description": "Cancel any order without ownership check",
      "vulnerable_param": "order_id",
      "param_location": "path",
      "test_with_id": 3,
      "evidence_field": "status",
      "difficulty": "hard"
    },
    {
      "id": "CUSTOM-IDOR-20",
      "idor_number": 20,
      "type": "referer_bypass",
      "endpoint": "/api/admin/reports",
      "method": "GET",
      "description": "Admin reports accessible by spoofing Referer header",
      "vulnerable_param": "Referer",
      "param_location": "header",
      "test_referer": "/admin/dashboard",
      "evidence_field": "report",
      "difficulty": "hard"
    }
  ]
}
